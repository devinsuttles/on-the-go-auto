# Enable mod_rewrite
<IfModule mod_rewrite.c>
  RewriteEngine On
</IfModule>

# Cache busting for hashed assets (1 year)
<FilesMatch "\.(js|css|woff2|woff|ttf|eot|svg|webp|png|jpg|jpeg|gif|ico)$">
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 year"
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>

# Short cache for HTML (1 day - allows updates without breaking cached assets)
<FilesMatch "\.html$">
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 day"
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=86400"
  </IfModule>
</FilesMatch>

# Very short cache for manifest and config files
<FilesMatch "\.(json|xml|webmanifest)$">
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </IfModule>
</FilesMatch>

# GZIP compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>
